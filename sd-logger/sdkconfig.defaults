# ESP32-S3 Target Configuration (Adafruit Feather ESP32-S3: 4MB Flash, 2MB PSRAM)
CONFIG_IDF_TARGET="esp32s3"

# Flash settings: 4MB Flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Custom Partition Table for 4MB Flash
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Enable PSRAM (2MB Embedded PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y

# Route console output directly through USB-C (USB Serial JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# FreeRTOS 1000Hz tick rate
CONFIG_FREERTOS_HZ=1000

# FATFS Configuration for SD Card
CONFIG_FATFS_LONG_FILENAMES=y
CONFIG_FATFS_MAX_LFN=128
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_PER_FILE_CACHE=y

# Log Level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
